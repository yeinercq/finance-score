<%= simple_form_for account, html: { class: "account form" } do |f| %>
  <% if account.errors.any? %>
    <div class="error-message">
      <%= account.errors.full_messages.to_sentence.capitalize %>
    </div>
  <% end %>

  <%= f.input :number, input_html: { autofocus: true } %>
  <%= f.input :name %>
  <%= f.input :nature, collection: Account.natures.map { |name, value| [name.capitalize, name] }, prompt: "Select account nature" %>
  <%= f.input :account_type, collection: Account.account_types.map { |name, value| [name.capitalize, name] }, prompt: "Select account type" %>
  
  <%= link_to "Cancel", accounts_path, class: "btn btn--light" %>
  <%= f.submit class: "btn btn--secondary" %>
<% end %>