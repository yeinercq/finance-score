<%= turbo_frame_tag account do %>
  <div class="account">
    <%= link_to "#{account.number} - #{account.name}", account_path(account), data: { turbo_frame: "_top" } %>
    <div class="account__actions">
      <%= link_to "Delete", account_path(account), class: "btn btn--light", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
      <%= link_to "Edit", edit_account_path(account), class: "btn btn--light" %>
    </div>
  </div>  
<% end %>